DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000

# Long random secrets - generate with: openssl rand -hex 32
# Never set TREASURY_PRIVATE_KEY here or anywhere on this server. The
# signer script in scripts/payout/ is meant to run on the project owner's
# own machine, never on Railway.
PAYOUT_READ_TOKEN=
PAYOUT_CONFIRM_TOKEN=
